# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Leave default or use local/Atlas URI)
# If local mongod is not running, SubTrack automatically uses in-memory MongoDB for zero-configuration viva!
MONGODB_URI=mongodb://127.0.0.1:27017/subtrack

# JWT Secret & Expiry
JWT_SECRET=subtrack_super_secret_jwt_key_mca_2026_demo_key
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Email / SMTP Configuration (Optional - If omitted, Email Simulation Mode will log to console)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SubTrack Alerts <no-reply@subtrack.local>"
